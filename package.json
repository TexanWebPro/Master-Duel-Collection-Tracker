{
  "name": "master-duel-collection-tracker",
  "productName": "master-duel-collection-tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "concurrently -k -n web,app \"vite dev\" \"wait-on tcp:3000 && electron . --dev\"",
    "build": "vite build",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "@tanstack/react-router": "latest",
    "@tanstack/react-start": "latest",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.49.0",
    "radix-ui": "^1.6.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^9.0.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0",
    "nitro": "latest",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.7.0",
    "vite": "^8.3.2",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.example.master-duel-collection-tracker",
    "files": [
      "electron/**",
      ".output/**",
      "package.json"
    ],
    "asarUnpack": [
      ".output/**"
    ],
    "directories": {
      "output": "release"
    }
  }
}
